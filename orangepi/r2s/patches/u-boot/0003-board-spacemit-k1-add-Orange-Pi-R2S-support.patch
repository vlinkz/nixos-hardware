diff --git a/arch/riscv/dts/k1-orangepi-r2s-u-boot.dtsi b/arch/riscv/dts/k1-orangepi-r2s-u-boot.dtsi
new file mode 100644
index 00000000000..2f7e84a9b42
--- /dev/null
+++ b/arch/riscv/dts/k1-orangepi-r2s-u-boot.dtsi
@@ -0,0 +1,130 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+
+#include "binman.dtsi"
+
+/ {
+	aliases {
+		i2c2 = &i2c2;
+		mmc0 = &emmc;
+	};
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0x00000000 0x00000000 0x00000000 0x80000000>;
+	};
+};
+
+&uart0 {
+	bootph-pre-ram;
+};
+
+&osc_32k {
+	bootph-pre-ram;
+};
+
+&vctcxo_1m {
+	bootph-pre-ram;
+};
+
+&vctcxo_3m {
+	bootph-pre-ram;
+};
+
+&vctcxo_24m {
+	bootph-pre-ram;
+};
+
+&syscon_mpmu {
+	bootph-pre-ram;
+};
+
+&pll {
+	bootph-pre-ram;
+};
+
+&syscon_apmu {
+	bootph-pre-ram;
+};
+
+&syscon_apbc {
+	bootph-pre-ram;
+};
+
+/*
+ * The board carries a 24c02 TLV EEPROM on I2C2 which holds the DDR
+ * configuration (rank count, data rate) read by SPL before DDR training.
+ * The upstream kernel DT does not describe it yet.
+ */
+&i2c2 {
+	bootph-pre-ram;
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c2_0_cfg>;
+	status = "okay";
+
+	eeprom@50 {
+		bootph-pre-ram;
+		compatible = "atmel,24c02";
+		reg = <0x50>;
+		pagesize = <8>;
+		read-only;
+		size = <256>;
+	};
+};
+
+/*
+ * U-Boot's regulator framework looks up suppliers by regulator-name.
+ * Provide the names SPL uses to program the rails DDR training and
+ * MMC depend on. aldo1 is the SD card I/O supply on this board.
+ */
+&i2c8 {
+	bootph-pre-ram;
+
+	pmic@41 {
+		bootph-pre-ram;
+
+		regulators {
+			buck1 {
+				regulator-name = "vdd_core";
+				bootph-pre-ram;
+			};
+
+			buck3 {
+				regulator-name = "vdd_1v8";
+				bootph-pre-ram;
+			};
+
+			aldo1 {
+				regulator-name = "vdd_1v8_mmc";
+				bootph-pre-ram;
+			};
+		};
+	};
+};
+
+&emmc {
+	bootph-pre-ram;
+	max-frequency = <204800000>;
+};
+
+&binman {
+	u-boot-spl-ddr {
+		type = "section";
+		filename = "u-boot-spl-ddr.bin";
+		pad-byte = <0xff>;
+
+		u-boot-spl {
+		};
+
+		ddr-fw {
+			type = "blob";
+			filename = "ddr_fw.bin";
+			align = <64>;
+		};
+
+		u-boot-any {
+			type = "section";
+			size = <0>;
+			offset = <0>;
+		};
+	};
+};
diff --git a/configs/orangepi_r2s_defconfig b/configs/orangepi_r2s_defconfig
new file mode 100644
index 00000000000..35112e79e99
--- /dev/null
+++ b/configs/orangepi_r2s_defconfig
@@ -0,0 +1,15 @@
+#include <configs/spacemit_k1_defconfig>
+
+CONFIG_DEFAULT_DEVICE_TREE="spacemit/k1-orangepi-r2s"
+CONFIG_OF_LIST="spacemit/k1-orangepi-r2s"
+CONFIG_DEFAULT_FDT_FILE="spacemit/k1-orangepi-r2s.dtb"
+CONFIG_SYS_MMCSD_RAW_MODE_U_BOOT_USE_SECTOR=y
+CONFIG_SYS_MMCSD_RAW_MODE_U_BOOT_SECTOR=0x800
+CONFIG_SUPPORT_EMMC_BOOT_OVERRIDE_PART_CONFIG=y
+CONFIG_SYS_MMCSD_RAW_MODE_EMMC_BOOT_PARTITION=0
+# Boot /boot/extlinux/extlinux.conf (or EFI) automatically
+CONFIG_BOOTSTD_FULL=y
+CONFIG_BOOTSTD_DEFAULTS=y
+CONFIG_USE_BOOTCOMMAND=y
+# Pass the MAC addresses from the TLV EEPROM to Linux
+CONFIG_ID_EEPROM=y
